# Model & quantization (default fits comfortably on 1x 24GB GPU: RTX 4090 / L4 / A10G)
SLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
QUANTIZATION=awq

# Latency & batching tuning for NYXORA's 8-way concurrent ~380-word chunk extraction
MAX_MODEL_LEN=2048
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=16
VLLM_PORT=8000

# Optional Bearer token (recommended when exposing port 8000 publicly, e.g., RunPod proxy)
VLLM_API_KEY=

# Optional Hugging Face token (only required for gated models)
HUGGING_FACE_HUB_TOKEN=
